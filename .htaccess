# Atlantis Travel – Apache / Hostinger (LiteSpeed) ayarları
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS'e yönlendir
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Kaynak ve yapılandırma dosyalarına dış erişimi engelle
RewriteRule ^(_kaynak|inc|storage|\.git)(/|$) - [F,L]
RewriteRule ^(README\.md|KURULUM\.md|\.gitignore)$ - [F,L]

# Eski Promake adresleri
RewriteRule ^turlar/?$ /services [R=301,L]
RewriteRule ^team/?$ /about [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^en/index\.html$ /en/ [R=301,L]
RewriteRule ^en$ /en/ [R=301,L]

# .html uzantısını adreste gösterme
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Sondaki eğik çizgiyi kaldır (klasör değilse)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Uzantısız adresi .html dosyasına bağla
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Geçici Hostinger adresinde arama motoru dizinlemesini kapat
<IfModule mod_headers.c>
SetEnvIfNoCase Host "hostingersite\.com|preview|\.hostinger" AT_TEMP_HOST
Header set X-Robots-Tag "noindex, nofollow" env=AT_TEMP_HOST

Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me"
</IfModule>

# Önbellek
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType application/xml "access plus 1 day"
</IfModule>

# Sıkıştırma
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
